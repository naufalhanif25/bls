# Project Build Outputs & Binary Artefacts
# Compiled executable binary output directory
/bin/

# Temporary object and assembly build directory
/build/

# Statically compiled object files
*.o

# Linker map files (useful for debugging, but shouldn't be tracked)
*.map

# Development Tools & Editor Artefacts
# VS Code configuration and workspace cache
.vscode/

# JetBrains IDEs (CLion, etc.) configuration directories
.idea/

# Vim/Neovim temporary swap and backup files
*.swp
*.swo
*~

# Debugger & Diagnostics Logs
# GNU Debugger (GDB) history and command logs
.gdb_history

# Valgrind or memory analyzer log output files
*.log
vgcore.*

# Core dumps generated by application crashes
core